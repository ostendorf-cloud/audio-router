{
  "ignores": [
    ".build/**",
    ".claude/worktrees/**",
    // The concept predates this lint and uses long lines and numbered phases.
    "docs/concepts/**",
    "CLAUDE.md"
  ],
  "config": {
    // The findings tables are filled by hand, so their pipes cannot stay aligned.
    "MD060": false,
    "MD013": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false
    }
  }
}
